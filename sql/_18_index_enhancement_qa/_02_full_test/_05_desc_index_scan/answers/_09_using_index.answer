Query plan:
iscan
    class: tb node[?]
    index: i_tb_a term[?] (covers)
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select tb.a from tb tb where (tb.a> ?:? ) using index tb.i_tb_a order by ? for orderby_num()> ?:?  and orderby_num()<= ?:? 
/* ---> skip ORDER BY */

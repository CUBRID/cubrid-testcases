Query stmt:
select sla.ca, slb.ca, slc.ca from sla sla, slb slb, slc slc where (sla.ca> ?:? ) and sla.ca=slb.ca and slb.ca=slc.ca order by ? desc  for orderby_num()<= ?:? 

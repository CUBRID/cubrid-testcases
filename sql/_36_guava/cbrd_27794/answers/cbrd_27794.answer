Query plan:
idx-join (left outer join)
    outer: sscan
               class: a node[?]
               cost:  ? card ?
    inner: iscan
               class: b node[?]
               index: idx term[?] (covers)
               filtr: term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from tbl a left outer join tbl b on a.cola=b.cola and a.colb= mod(b.colb, ?)

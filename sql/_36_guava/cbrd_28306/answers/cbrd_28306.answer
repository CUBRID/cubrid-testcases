Query plan:
temp(group by)
    subplan: iscan
                 class: ta node[?]
                 index: i_ta_cb term[?]
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select /*+ INDEX_LS */ ta.ca, count(distinct ta.cb) from ta ta where ta.cb= ?:?  group by ta.ca having groupby_num()<=?

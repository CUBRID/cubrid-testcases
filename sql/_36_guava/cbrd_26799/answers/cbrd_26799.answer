Query plan:
iscan
    class: t node[?]
    index: idx term[?] (index skip scan)
    cost:  ? card ?
Query stmt:
(select /*+ INDEX_SS NO_MERGE */ t.i, t.j, t.k, t.l from t t where (t.j>= ?:?  and t.j<= ?:? ))
Query plan:
sscan
    class: tt node[?]
    cost:  ? card ?
Query stmt:
(select count(*) from (select /*+ INDEX_SS NO_MERGE */ t.i, t.j, t.k, t.l from t t where (t.j>= ?:?  and t.j<= ?:? )) tt (i, j, k, l))
Query plan:
iscan
    class: t node[?]
    index: idx term[?] (index skip scan)
    cost:  ? card ?
Query stmt:
(select /*+ INDEX_SS NO_MERGE */ t.i, t.j, t.k, t.l from t t where (t.j>= ?:?  and t.j<= ?:? ))
Query plan:
sscan
    class: tt node[?]
    cost:  ? card ?
Query stmt:
(select count(*) from (select /*+ INDEX_SS NO_MERGE */ t.i, t.j, t.k, t.l from t t where (t.j>= ?:?  and t.j<= ?:? )) tt (i, j, k, l))
Query plan:
sscan
    class: dual node[?]
    cost:  ? card ?
Query stmt:
select case when (select count(*) from (select /*+ INDEX_SS NO_MERGE */ t.i, t.j, t.k, t.l from t t where (t.j>= ?:?  and t.j<= ?:? )) tt (i, j, k, l))=? and (select count(*) from (select /*+ INDEX_SS NO_MERGE */ t.i, t.j, t.k, t.l from t t where (t.j>= ?:?  and t.j<= ?:? )) tt (i, j, k, l))=? then 'OK' else 'INDEX ROW LOSS' end from dual dual

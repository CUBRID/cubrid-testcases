nl-join (inner join)
    edge:  term[?]
    outer: iscan
               class: t node[?]
               index: idx_fi_t term[?]
               cost:  ? card ?
    inner: sscan
               class: u node[?]
               sargs: term[?]
               cost:  ? card ?
    sort:  ? asc, ? asc
    cost:  ? card ?
Query stmt:
select /*+ ORDERED USE_NL */ t.i?,  sqrt(t.d?), u.x from fi_t t, fi_u u where (t.i?>= ?:?  and t.i?<= ?:? ) and  sqrt(t.d?)=u.y order by ?

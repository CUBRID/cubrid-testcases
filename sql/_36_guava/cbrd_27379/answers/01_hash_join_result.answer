Query plan:
temp(order by)
    subplan: hash-join (semi join)
                 edge:  term[?]
                 outer: sscan
                            class: ta node[?]
                            cost:  ? card ?
                 inner: sscan
                            class: tb node[?]
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select /*+ USE_HASH */ ta.ca from ta ta semi join tb tb on tb.ca=ta.ca order by ?

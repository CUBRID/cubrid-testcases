ca    
1     
2     

Query plan:
sscan
    class: tb node[?]
    sargs: term[?] AND term[?]
    cost:  ? card ?
Query stmt:
(select /*+ NO_UNNEST */ ? from tb tb where (tb.ca=ta.ca) and inst_num()<= ?:? )
Query plan:
temp(order by)
    subplan: sscan
                 class: ta node[?]
                 sargs: term[?]
                 subqs: ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select ta.ca from ta ta where  exists (select /*+ NO_UNNEST */ ? from tb tb where (tb.ca=ta.ca) and inst_num()<= ?:? ) order by ?

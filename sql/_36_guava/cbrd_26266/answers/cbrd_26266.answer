                 outer: sscan
                            class: a node[?]
                            cost:  ? card ?
                 inner: iscan
                            class: b node[?]
                            index: idx_join_b_col_a term[?] (covers)
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc, ? asc
    cost:  ? card ?
Query stmt:
select a.col_a, b.col_a,  upper( cast(a.col_a as varchar)) from tbl_join_a a, tbl_join_b b where b.col_a= cast( upper( cast(a.col_a as varchar)) as double) order by ?, ? for orderby_num()<= ?:? 

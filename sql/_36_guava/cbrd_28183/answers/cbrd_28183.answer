select t_cust.c_id, t_nat.n_name,  cast(sum(gbp_?.gbp_a_?) as integer) from (select t_ord.o_cust, sum( cast(t_li.l_qty as bigint)) from t_li t_li, t_ord t_ord where t_li.l_ord=t_ord.o_id group by t_ord.o_cust) gbp_? (gbp_a_?, gbp_a_?), t_cust t_cust left outer join t_nat t_nat on t_cust.c_nat=t_nat.n_id where gbp_?.gbp_a_?=t_cust.c_id group by t_cust.c_id, t_nat.n_name order by ? desc , ? for orderby_num()<= ?:? 

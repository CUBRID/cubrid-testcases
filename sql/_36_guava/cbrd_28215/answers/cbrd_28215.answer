Query plan:
nl-join (semi join)
    edge:  term[?]
    outer: sscan
               class: o node[?]
               cost:  ? card ?
    inner: iscan
               class: i node[?]
               index: ix_k term[?] (covers)
               filtr: term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select /*+ USE_NL */ count(*) from io o semi join  all ia i on (i.k>= ?:? ) and i.k=o.k

    edge:  term[?]
    outer: nl-join (semi join)
               edge:  term[?]
               outer: sscan
                          class: t? node[?]
                          cost:  ? card ?
               inner: sscan
                          class: ix node[?]
                          sargs: term[?]
                          cost:  ? card ?
               cost:  ? card ?
    inner: iscan
               class: t? node[?]
               index: ix_k term[?] (covers)
               filtr: term[?]
               cost:  ? card ?
    cost:  ? card ?

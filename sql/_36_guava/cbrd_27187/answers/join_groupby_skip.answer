Query plan:
temp(group by)
    subplan: nl-join (inner join)
                 edge:  term[?]
                 outer: iscan
                            class: a node[?]
                            index: i_a_g 
                            cost:  ? card ?
                 inner: sscan
                            class: h node[?]
                            sargs: term[?]
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select /*+ ORDERED */ a.g, count(*) from t_a a,  all t_h h where h.a_id=a.id group by a.g using index a.i_a_g

Query plan:
temp(group by)
    subplan: sscan
                 class: t_big node[?]
                 sargs: term[?]
                 cost:  ? card ?
    sort:  ? asc, ? asc, ? asc, ? asc
    cost:  ? card ?
Query stmt:
(select t_big.a from t_big t_big where (t_big.e< ?:? ) group by t_big.a, t_big.b, t_big.c, t_big.d)
Query plan:
hash-join (inner join)
    edge:  term[?]
    outer: sscan
               class: t node[?]
               cost:  ? card ?
    inner: sscan
               class: m node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from (select t_big.a from t_big t_big where (t_big.e< ?:? ) group by t_big.a, t_big.b, t_big.c, t_big.d) t (a), t_dim m where t.a=m.id

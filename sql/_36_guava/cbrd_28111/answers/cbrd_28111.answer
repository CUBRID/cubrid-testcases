Query plan:
temp(order by)
    subplan: idx-join (inner join)
                 outer: iscan
                            class: c node[?]
                            index: idx_os_c_grp term[?]
                            cost:  ? card ?
                 inner: iscan
                            class: o node[?]
                            index: idx_os_o_cid term[?]
                            sargs: term[?]
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select o.id, c.[name] from os_o o, os_c c where o.cid=c.cid and c.grp= ?:?  and o.q= ?:?  order by ? for orderby_num()<= ?:? 

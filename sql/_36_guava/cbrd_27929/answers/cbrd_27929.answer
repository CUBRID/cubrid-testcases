Case 3: EXISTS and NOT EXISTS in one query on a large outer -> the ANTI JOIN kept, the EXISTS put back     

===================================================
count(*)    
1667     

Query plan:
hash-join (inner join)
    edge:  term[?]
    outer: sscan
               class: tm node[?]
               cost:  ? card ?
    inner: sscan
               class: tn node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select tm.ca from tm tm, tn tn where tm.cb=tn.ca)
Query plan:
nl-join (cross join)
    outer: iscan
               class: tb node[?]
               index: i_tb_ca term[?] (covers)
               cost:  ? card ?
    inner: iscan
               class: tc node[?]
               index: i_tc_ca term[?] (covers)
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select tb.ca, tc.ca from tb tb, tc tc where tc.ca=tl.cb and tb.ca=tl.ca limit ?)
Query plan:
hash-join (anti join)
    edge:  term[?]
    outer: sscan
               class: tl node[?]
               sargs: term[?]
               subqs: ?
               cost:  ? card ?
    inner: sscan
               class: av?_? node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from tl tl anti join (select tm.ca from tm tm, tn tn where tm.cb=tn.ca) av?_? (av_?) on av?_?.av_?=tl.ca where  exists (select tb.ca, tc.ca from tb tb, tc tc where tc.ca=tl.cb and tb.ca=tl.ca limit ?)

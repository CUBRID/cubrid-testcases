count(*)    
10000     

Query plan:
hash-join (inner join)
    edge:  term[?]
    outer: sscan
               class: tm node[?]
               cost:  ? card ?
    inner: sscan
               class: tn node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select tm.ca from tm tm, tn tn where tm.cb=tn.ca)
Query plan:
hash-join (semi join)
    edge:  term[?]
    outer: sscan
               class: tl node[?]
               cost:  ? card ?
    inner: sscan
               class: av? node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from tl tl semi join (select tm.ca from tm tm, tn tn where tm.cb=tn.ca) av? (av_?) on av?.av_?=tl.ca

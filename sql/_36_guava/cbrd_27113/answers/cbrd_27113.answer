Query plan:
sscan
    class: ic_fact node[?]
    sargs: term[?]
    cost:  ? card ?
Query stmt:
select count(ic_fact.pad) from ic_fact ic_fact where (ic_fact.grp>= ?:?  and ic_fact.grp<= ?:? )

Query plan:
iscan
    class: t? node[?]
    index: i_t?_a term[?]
    sargs: term[?]
    cost:  ? card ?
Query stmt:
select t?.a, t?.b from t? t? where (t?.a> ?:? ) and (rownum<= ?:? )

                            index: idx? term[?] (covers)
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
(select a.col? from t? a, t? b where a.col?=b.col? group by a.col?)
Query plan:
nl-join (inner join)
    edge:  term[?]
    outer: sscan
               class: bb node[?]
               cost:  ? card ?
    inner: sscan
               class: aa node[?]
               sargs: term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from (select a.col? from t? a, t? b where a.col?=b.col? and a.col?= ?:?  group by a.col?) aa (col?), (select a.col? from t? a, t? b where a.col?=b.col? group by a.col?) bb (col?) where aa.col?=bb.col?

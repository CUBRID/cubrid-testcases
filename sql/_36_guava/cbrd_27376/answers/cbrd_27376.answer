Query plan:
idx-join (inner join)
    outer: sscan
               class: t_a node[?]
               cost:  ? card ?
    inner: iscan
               class: t_b node[?]
               index: i_t_b_v term[?] (covers)
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select t_a.k from t_a t_a, t_b t_b where t_a.v=t_b.v)
Query plan:
nl-join (semi join)
    edge:  term[?]
    outer: sscan
               class: t_o node[?]
               cost:  ? card ?
    inner: sscan
               class: av? node[?]
               sargs: term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select /*+ PARALLEL(?) */ count(*) from t_o t_o semi join (select t_a.k from t_a t_a, t_b t_b where t_a.v=t_b.v) av? (av_?) on av?.av_?=t_o.k

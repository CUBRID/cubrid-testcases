Query plan:
idx-join (inner join)
    outer: sscan
               class: s node[?]
               cost:  ? card ?
    inner: iscan
               class: b node[?]
               index: pk_sq_big_id term[?] (covers)
               sargs: term[?]
               subqs: ?
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from sq_big b, sq_small s where s.a_id=b.id and (select count(*) from sq_child c where c.big_id=b.id)>?

300     

Query plan:
temp(distinct)
    subplan: iscan
                 class: pair node[?]
                 index: pk_pair_id term[?]
                 cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select distinct pair.b from pair pair where (pair.id< ?:? ))
Query plan:
iscan
    class: pair node[?]
    index: i_pair_ab term[?] (covers)
    filtr: term[?]
    cost:  ? card ?
Query stmt:
select count(*) from pair pair where ((pair.a= ?:?  and pair.b in (select distinct pair.b from pair pair where (pair.id< ?:? ))) or (pair.a= ?:?  and pair.b= ?:? )) and ((pair.a= ?:? ) or (pair.a= ?:? ))

Query stmt:
select count(*) from nat sn, nat cn, fact fact where sn.id=fact.id and ((sn.n_name= ?:? ) or (sn.n_name= ?:? )) and ((cn.n_name= ?:? ) or (cn.n_name= ?:? )) and sn.n_name<>cn.n_name

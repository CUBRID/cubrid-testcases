               sargs: term[?]
               cost:  ? card ?
    inner: sscan
               class: b node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*), sum(a.id), sum(b.id), count(a.id) from t_big? a right outer join t_big? b on (a.id> ?:? ) and a.k=b.k

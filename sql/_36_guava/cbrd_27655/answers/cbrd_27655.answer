1     2     3     
2     2     3     
3     2     3     
4     0     0     
5     0     0     
6     2     3     
7     4     0     
8     4     0     
9     3     4     

===================================================
    
Case 4: REGEXP_SUBSTR, the same occurrences     

===================================================
regexp_substr('abc', 'b*', 1, 2)    regexp_substr('abc', 'b*', 1, 3)    regexp_substr('abc', 'b*', 1, 5)    regexp_substr('가나다', '나*', 1, 2)    
b          null     나     

===================================================
id    regexp_substr(s, p, 1, 2)    
1          
2     b     
3          
4     null     
5     null     
6     나     
7          
8     b     
9     c     

===================================================
    
Case 5: REGEXP_REPLACE, all matches, from a position, and one occurrence     

===================================================
regexp_replace('abc', 'b*', 'X')    regexp_replace('abc', 'a|', 'X')    regexp_replace('abc', '^', '>')    regexp_replace('abc', '$', '<')    
XaXXcX     XXbXcX     >abc     abc<     

===================================================
regexp_replace('abc', 'b*', 'X', 2)    regexp_replace('abc', 'b*', 'X', 1, 2)    regexp_replace('AbA', 'a*', 'X', 1, 0, 'i')    
aXXcX     aXc     XXbXX     

===================================================
id    regexp_replace(s, p, '-')    
1     --b-c-     
2     -a--c-     
3     -a-b-c-     
4     -abc     
5     abc-     
6     -가--다-     
7     --     
8     a-c-     
9     -b--b-     

===================================================
    
Case 6: a long subject with an empty match at every position     

===================================================
regexp_count( repeat('ab', 5000), 'x*')    char_length(regexp_replace( repeat('ab', 5000), 'b*', 'X'))    
10001     15001     


===================================================
    
1-1. INT + INT => INT     

===================================================
cast(2 as integer)+ cast(1 as integer)    typeof( cast(2 as integer)+ cast(1 as integer))    
3     integer     

===================================================
    
1-2. INT + BIGINT => BIGINT     

===================================================
cast(2 as integer)+ cast(1 as bigint)    typeof( cast(2 as integer)+ cast(1 as bigint))    
3     bigint     

===================================================
    
1-3. INT + Fixed NUMERIC => Float NUMERIC     

===================================================
cast(2 as integer)+ cast(1 as numeric(1,0))    typeof( cast(2 as integer)+ cast(1 as numeric(1,0)))    
3     numeric     

===================================================
    
1-4. INT + Float NUMERIC => Float NUMERIC     

===================================================
cast(2 as integer)+ cast(1 as numeric)    typeof( cast(2 as integer)+ cast(1 as numeric))    
3     numeric     

===================================================
    
1-5. INT + FLOAT => FLOAT     

===================================================
cast(2 as integer)+ cast(2.1 as float)    typeof( cast(2 as integer)+ cast(2.1 as float))    
4.1     float     

===================================================
    
1-6. INT + DOUBLE => DOUBLE     

===================================================
cast(2 as integer)+ cast(2.1 as double)    typeof( cast(2 as integer)+ cast(2.1 as double))    
4.1     double     

===================================================
    
1-7. INT + high-precision Float NUMERIC preserves full precision     

===================================================
cast(1 as integer)+ cast(0.12345678901234567890123456789012345678 as numeric)    typeof( cast(1 as integer)+ cast(0.12345678901234567890123456789012345678 as numeric))    
1.12345678901234567890123456789012345678     numeric     

===================================================
    
1-8. INT with -, *, / and NUMERIC, and INT / INT integer division     

===================================================
cast(2 as integer)- cast(1 as numeric)    typeof( cast(2 as integer)- cast(1 as numeric))    
1     numeric     

===================================================
cast(2 as integer)* cast(3 as numeric)    typeof( cast(2 as integer)* cast(3 as numeric))    
6     numeric     

===================================================
cast(1 as integer)/ cast(3 as numeric)    typeof( cast(1 as integer)/ cast(3 as numeric))    
0.3333333333333333333333333333333333333333     numeric     

===================================================
cast(1 as integer)/ cast(3 as integer)    typeof( cast(1 as integer)/ cast(3 as integer))    
0     integer     


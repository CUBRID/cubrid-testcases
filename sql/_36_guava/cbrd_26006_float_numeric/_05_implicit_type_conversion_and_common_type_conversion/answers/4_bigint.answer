===================================================
    
1-1. BIGINT + BIGINT => BIGINT     

===================================================
cast(2 as bigint)+ cast(1 as bigint)    typeof( cast(2 as bigint)+ cast(1 as bigint))    
3     bigint     

===================================================
    
1-2. BIGINT + Fixed NUMERIC => Float NUMERIC     

===================================================
cast(2 as bigint)+ cast(1 as numeric(1,0))    typeof( cast(2 as bigint)+ cast(1 as numeric(1,0)))    
3     numeric     

===================================================
    
1-3. BIGINT + Float NUMERIC => Float NUMERIC     

===================================================
cast(2 as bigint)+ cast(1 as numeric)    typeof( cast(2 as bigint)+ cast(1 as numeric))    
3     numeric     

===================================================
    
1-4. BIGINT + FLOAT => FLOAT     

===================================================
cast(2 as bigint)+ cast(1 as float)    typeof( cast(2 as bigint)+ cast(1 as float))    
3.0     float     

===================================================
    
1-5. BIGINT + DOUBLE => DOUBLE     

===================================================
cast(2 as bigint)+ cast(1 as double)    typeof( cast(2 as bigint)+ cast(1 as double))    
3.0     double     

===================================================
    
1-6. BIGINT + high-precision Float NUMERIC preserves full precision     

===================================================
cast(1 as bigint)+ cast(0.12345678901234567890123456789012345678 as numeric)    typeof( cast(1 as bigint)+ cast(0.12345678901234567890123456789012345678 as numeric))    
1.12345678901234567890123456789012345678     numeric     

===================================================
    
1-7. BIGINT with -, *, / and NUMERIC, and BIGINT / BIGINT integer division     

===================================================
cast(2 as bigint)- cast(1 as numeric)    typeof( cast(2 as bigint)- cast(1 as numeric))    
1     numeric     

===================================================
cast(2 as bigint)* cast(3 as numeric)    typeof( cast(2 as bigint)* cast(3 as numeric))    
6     numeric     

===================================================
cast(1 as bigint)/ cast(3 as numeric)    typeof( cast(1 as bigint)/ cast(3 as numeric))    
0.3333333333333333333333333333333333333333     numeric     

===================================================
cast(1 as bigint)/ cast(3 as bigint)    typeof( cast(1 as bigint)/ cast(3 as bigint))    
0     bigint     


===================================================
    
1-1. SHORT + SHORT => SHORT     

===================================================
cast(2 as smallint)+ cast(1 as smallint)    typeof( cast(2 as smallint)+ cast(1 as smallint))    
3     smallint     

===================================================
    
1-2. SHORT + INT => INT     

===================================================
cast(2 as smallint)+ cast(1 as integer)    typeof( cast(2 as smallint)+ cast(1 as integer))    
3     integer     

===================================================
    
1-3. SHORT + BIGINT => BIGINT     

===================================================
cast(2 as smallint)+ cast(1 as bigint)    typeof( cast(2 as smallint)+ cast(1 as bigint))    
3     bigint     

===================================================
    
1-4. SHORT + Fixed NUMERIC => Float NUMERIC     

===================================================
cast(2 as smallint)+ cast(1 as numeric(1,0))    typeof( cast(2 as smallint)+ cast(1 as numeric(1,0)))    
3     numeric     

===================================================
    
1-5. SHORT + Float NUMERIC => Float NUMERIC     

===================================================
cast(2 as smallint)+ cast(1 as numeric)    typeof( cast(2 as smallint)+ cast(1 as numeric))    
3     numeric     

===================================================
    
1-6. SHORT + FLOAT => FLOAT     

===================================================
cast(2 as smallint)+ cast(2.1 as float)    typeof( cast(2 as smallint)+ cast(2.1 as float))    
4.1     float     

===================================================
    
1-7. SHORT + DOUBLE => DOUBLE     

===================================================
cast(2 as smallint)+ cast(2.1 as double)    typeof( cast(2 as smallint)+ cast(2.1 as double))    
4.1     double     


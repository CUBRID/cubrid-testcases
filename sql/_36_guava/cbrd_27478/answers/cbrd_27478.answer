hash-join (inner join)
    edge:  term[?]
    outer: idx-join (inner join)
               outer: sscan
                          class: c node[?]
                          sargs: term[?]
                          cost:  ? card ?
               inner: iscan
                          class: f node[?]
                          index: i_?_f_c term[?]
                          cost:  ? card ?
               cost:  ? card ?
    inner: sscan
               class: g node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from t_?_c c, t_?_f f, t_?_g g where f.c_id=c.id and g.k=f.k and c.[name]= ?:? 

Query plan:
temp(order by)
    subplan: nl-join (anti join)
                 edge:  term[?]
                 outer: iscan
                            class: n? node[?]
                            index: i_n? term[?] (covers)
                            cost:  ? card ?
                 inner: sscan
                            class: m? node[?]
                            sargs: term[?] AND term[?]
                            cost:  ? card ?
                 during:term[?]
                 cost:  ? card ?
    sort:  ? asc, ? asc
    cost:  ? card ?
Query stmt:
select n?.a, n?.b, n?.c from n? n? anti join m? m? on m?.x=n?.c+? and n?.b= ?:?  where (n?.a> ?:? ) order by ?, ?

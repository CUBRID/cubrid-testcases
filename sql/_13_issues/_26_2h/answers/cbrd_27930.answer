Query plan:
temp(order by)
    subplan: iscan
                 class: t_roll node[?]
                 index: i_roll term[?] (covers)
                 sort:  ? asc, ? asc
                 cost:  ? card ?
    sort:  ? asc, ? asc
    cost:  ? card ?
Query stmt:
select t_roll.ka, t_roll.kb, count(distinct t_roll.v), median(t_roll.v), percentile_cont( cast(?.? as double)) within group (order by t_roll.v), group_concat(t_roll.v order by ?), count(t_roll.v), sum(t_roll.v) from t_roll t_roll where (t_roll.ka> ?:? ) group by t_roll.ka, t_roll.kb with rollup using index t_roll.i_roll(+) order by ?, ?

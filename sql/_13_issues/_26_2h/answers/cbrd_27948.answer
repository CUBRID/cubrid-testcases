===================================================
case 'q' when k then 1.5 when 'z' then 1 when k then null else 2 end    
2     

===================================================
decode('q', k, 1.5, 'z', 1, k, null, 2)    
2     

===================================================
decode('q', k, n, 'z', bi, k, null, bi)    
1     


Query plan:
nl-join (left outer join)
    edge:  term[?]
    outer: iscan
               class: o node[?]
               index: pk_t?o_id (covers)
               cost:  ? card ?
    inner: sscan
               class: i node[?]
               sargs: term[?] AND term[?]
               cost:  ? card ?
    after: term[?]
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select o.id from t?o o left outer join t?i i on o.id=i.id where coalesce(i.d,  SYS_DATE ) is not null  order by ? for orderby_num()<= ?:? 

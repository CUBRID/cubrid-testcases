    outer: sscan
               class: vc node[?]
               cost:  ? card ?
    inner: sscan
               class: tb node[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select vc.ca from ta vc, tb tb)
Query plan:
nl-join (left outer join)
    edge:  term[?]
    outer: sscan
               class: td node[?]
               cost:  ? card ?
    inner: temp
               order: UNORDERED
               subplan: nl-join (cross join)
                            outer: sscan
                                       class: tc node[?]
                                       cost:  ? card ?
                            inner: sscan
                                       class: vc node[?]
                                       cost:  ? card ?
                            cost:  ? card ?
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*), count(vc.ca) from (select vc.ca from ta vc, tb tb) vc (ca) cross join tc tc right outer join td td on td.ca=tc.ca

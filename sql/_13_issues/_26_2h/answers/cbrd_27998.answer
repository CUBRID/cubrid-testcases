Case 1: VARCHAR IN a CHAR column of a UNION ALL view becomes a join with a DISTINCT derived table     

===================================================
c1    
a     

Query plan:
sscan
    class: v? node[?]
    cost:  ? card ?
Query stmt:
select v?.c? from t? v?
Query plan:
sscan
    class: v? node[?]
    cost:  ? card ?
Query stmt:
select v?.c? from t? v?
Query plan:
temp(distinct)
    subplan: sscan
                 class: v? node[?]
                 cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select distinct  cast(v?.c? as varchar(?)) from (select v?.c? from t? v? union all select v?.c? from t? v?) v? (c?))
Query plan:
temp(order by)
    subplan: nl-join (inner join)
                 edge:  term[?]
                 outer: sscan
                            class: t? node[?]
                            cost:  ? card ?
                 inner: sscan
                            class: av? node[?]
                            sargs: term[?]
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select t?.c? from t? t?, (select distinct  cast(v?.c? as varchar(?)) from (select v?.c? from t? v? union all select v?.c? from t? v?) v? (c?)) av? (av_?) where t?.c?=av?.av_? order by ?

    edge:  term[?]
    outer: iscan
               class: n? node[?]
               index: i_n? term[?] (covers)
               filtr: term[?]
               cost:  ? card ?
    inner: sscan
               class: m? node[?]
               sargs: term[?]
               cost:  ? card ?
    sort:  ? asc, ? asc
    cost:  ? card ?
Query stmt:

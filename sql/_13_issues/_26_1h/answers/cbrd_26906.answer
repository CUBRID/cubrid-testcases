Query plan:
idx-join (inner join)
    outer: sscan
               class: dim node[?]
               cost:  ? card ?
    inner: iscan
               class: tbl node[?]
               index: idx_non_covering term[?] AND term[?]
               filtr: term[?]
               sargs: term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from tbl tbl, dim dim where (tbl.cola>= ?:?  and tbl.cola<= ?:? ) and tbl.cola=dim.k and tbl.colc= ?:?  and tbl.colb= ?:?  using index tbl.idx_non_covering

0
===================================================
    
Case 2.1: DATE upper boundary overflow     

===================================================
adddate('9999-12-31', 1)    
null     

===================================================
adddate('9999-12-31', 999999)    
null     

===================================================
date_add('9999-12-31', INTERVAL 1 DAY)    
null     

===================================================
date_add('9999-12-31', INTERVAL 1 MONTH)    
null     

===================================================
date_add('9999-12-31', INTERVAL 1 YEAR)    
null     

===================================================
date_add('9999-06-01', INTERVAL 999999 DAY)    
null     

===================================================
subdate('9999-12-31', -1)    
null     

===================================================
date_sub('9999-12-31', INTERVAL -1 DAY)    
null     

===================================================
    
Case 2.2: DATE lower boundary underflow     

===================================================
date_add('0001-01-01', INTERVAL -2 YEAR)    
null     

===================================================
adddate('0001-01-01', -500)    
null     

===================================================
date_sub('0001-01-01', INTERVAL 2 YEAR)    
null     

===================================================
date_sub('0001-01-01', INTERVAL 13 MONTH)    
null     

===================================================
date_sub('0001-01-01', INTERVAL 500 DAY)    
null     

===================================================
    
Case 2.3: DATETIME upper boundary overflow     

===================================================
date_add(datetime '9999-12-31 23:59:59.999', INTERVAL 1 MILLISECOND)    
null     

===================================================
date_add(datetime '9999-12-31 23:59:59.999', INTERVAL 1 SECOND)    
null     

===================================================
date_add(datetime '9999-12-31 23:59:59.999', INTERVAL 1 DAY)    
null     

===================================================
date_add(datetime '9999-12-31 23:59:59.999', INTERVAL 1 YEAR)    
null     

===================================================
date_sub(datetime '9999-12-31 23:59:59.999', INTERVAL -1 MILLISECOND)    
null     

===================================================
date_add(datetime '9999-12-31 23:59:59', INTERVAL '1:0' MINUTE_SECOND)    
null     

===================================================
    
Case 2.4: DATETIME lower boundary underflow     

===================================================
date_sub(datetime '0001-01-01 00:00:00.000', INTERVAL 1 MILLISECOND)    
null     

===================================================
date_sub(datetime '0001-01-01 00:00:00.000', INTERVAL 1 SECOND)    
null     

===================================================
date_sub(datetime '0001-01-01 00:00:00.000', INTERVAL 1 HOUR)    
null     

===================================================
date_sub(datetime '0001-01-01 00:00:00.000', INTERVAL 1 DAY)    
null     


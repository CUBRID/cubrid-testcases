9. Mixed LEFT JOIN + RIGHT JOIN (no mergable)     

===================================================
count(*)    
2     

Query plan:
sscan
    class: tbl_b node[?]
    sargs: term[?]
    cost:  ? card ?
Query stmt:
(select tbl_b.colb from tbl_b tbl_b where (tbl_b.x>= ?:? ))
Query plan:
sscan
    class: tbl_c node[?]
    sargs: term[?]
    cost:  ? card ?
Query stmt:
(select tbl_c.colc from tbl_c tbl_c where (tbl_c.y>= ?:? ))
Query plan:
nl-join (left outer join)
    edge:  term[?]
    outer: sscan
               class: d node[?]
               cost:  ? card ?
    inner: temp
               order: UNORDERED
               subplan: nl-join (left outer join)
                            edge:  term[?]
                            outer: sscan
                                       class: a node[?]
                                       cost:  ? card ?
                            inner: sscan
                                       class: b node[?]
                                       sargs: term[?]
                                       cost:  ? card ?
                            cost:  ? card ?
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select count(*) from tbl_a a left outer join (select tbl_b.colb from tbl_b tbl_b where (tbl_b.x>= ?:? )) b (colb) on a.colb=b.colb right outer join (select tbl_c.colc from tbl_c tbl_c where (tbl_c.y>= ?:? )) d (colc) on a.cola=d.colc
===================================================
    

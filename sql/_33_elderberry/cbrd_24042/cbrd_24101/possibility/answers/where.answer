Query plan:
nl-join (inner join)
    edge:  term[?]
    outer: sscan
               class: a node[?]
               sargs: term[?]
               cost:  ? card ?
    inner: sscan
               class: b node[?]
               sargs: term[?] AND term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
(select a.col_a from t_a a, t_b b where (a.col_a=b.col_a) and (a.col_a> ?:?  and a.col_a< ?:? ) and (b.col_a> ?:? ))
Query plan:
nl-join (semi join)
    edge:  term[?]
    outer: sscan
               class: aa node[?]
               cost:  ? card ?
    inner: sscan
               class: av? node[?]
               sargs: term[?]
               cost:  ? card ?
    cost:  ? card ?
Query stmt:
select aa.col_a from t_a aa semi join (select a.col_a from t_a a, t_b b where (a.col_a=b.col_a) and (a.col_a> ?:?  and a.col_a< ?:? ) and (b.col_a> ?:? )) av? (av_?) on av?.av_?=aa.col_a

Query plan:
temp(group by)
    subplan: sscan
                 class: Z node[?]
                 sargs: term[?]
                 cost:  ? card ?
    sort:  ? desc
    cost:  ? card ?
Query stmt:
select Z.cola from (select a.cola, (orderby_num()) from ta a order by ?) Z (cola, rn) where (Z.rn>= ?:?  and Z.rn<= ?:? ) group by Z.cola desc  having groupby_num() between ? and ?

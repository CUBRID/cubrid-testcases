Query plan:
temp(order by)
    subplan: idx-join (inner join)
                 outer: sscan
                            class: Z node[?]
                            cost:  ? card ?
                 inner: iscan
                            class: tb node[?]
                            index: pk_tb_k term[?] (covers)
                            cost:  ? card ?
                 cost:  ? card ?
    sort:  ? asc
    cost:  ? card ?
Query stmt:
select (orderby_num()), Z.cola, Z.colb from ta Z, tb tb where Z.cola=tb.k order by ? for (orderby_num()) between  ?:?  and  ?:? 
